diff --git a/Commands68k/Command68kException.cpp b/Commands68k/Command68kException.cpp
new file mode 100644
index 0000000..edcc787
--- /dev/null
+++ b/Commands68k/Command68kException.cpp
@@ -0,0 +1,48 @@
+#include "Command68kException.h"
+
+#define COMMAND_NAME "EXCPT"
+
+void Command68kException::GetName(char *name) const
+{
+    strncpy(name, COMMAND_NAME, COMMAND68K_NAME_LENGTH);
+}
+
+static const char *VectorName(uint16_t vector)
+{
+    switch (vector)
+    {
+        case 2: return "bus error";
+        case 3: return "address error";
+        case 4: return "illegal instruction";
+        case 5: return "divide by zero";
+        case 6: return "CHK";
+        case 7: return "TRAPV";
+        case 8: return "privilege violation";
+        case 10: return "line A opcode";
+        case 11: return "line F opcode";
+        case 24: return "unexpected interrupt";
+        default: return "reserved vector";
+    }
+}
+
+void Command68kException::Execute()
+{
+    uint16_t v[6] = { 0, 0, 0, 0, 0, 0 };
+    int count = 0;
+    while (count < 6 && InputBuffer::GetValue(&v[count]))
+    {
+        ++count;
+    }
+    if (count < 4)
+    {
+        printf("\n*** 68000 exception (incomplete report) ***\n");
+        return;
+    }
+    uint32_t pc = ((uint32_t)v[2] << 16) | v[3];
+    printf("\n*** 68000 exception: %s (vector %d) at PC $%06lx, SR $%04x", VectorName(v[0]), v[0], (unsigned long)pc, v[1]);
+    if ((v[0] == 2 || v[0] == 3) && count == 6)
+    {
+        printf(", access $%06lx", (unsigned long)(((uint32_t)v[4] << 16) | v[5]));
+    }
+    printf(" ***\n(PC/SR are read from the exception frame in work RAM)\n");
+}
diff --git a/Commands68k/Command68kException.h b/Commands68k/Command68kException.h
new file mode 100644
index 0000000..a797a79
--- /dev/null
+++ b/Commands68k/Command68kException.h
@@ -0,0 +1,13 @@
+#pragma once
+
+#include "Command68k.h"
+
+// EXCPT: sent by the 68000 exception handlers of a BricoNeo ROM (Brico68k).
+// Values after the name: vector number, SR, PC high, PC low, access address
+// high, access address low (bus/address errors only, else 0).
+class Command68kException : public Command68k
+{
+public:
+    virtual void GetName(char *name) const;
+    virtual void Execute();
+};
diff --git a/InputBuffer.cpp b/InputBuffer.cpp
index 047a34c..840c2e4 100644
--- a/InputBuffer.cpp
+++ b/InputBuffer.cpp
@@ -6,13 +6,50 @@
 #define ADDRESS_END ((uint16_t *)(BASE_ADDRESS_INPUT_RING_BUFFER + (1 << INPUT_BUFFER_SIZE_POWEROF2)))
 
 uint16_t *InputBuffer::gpNextReadPosition = ADDRESS_START;
+uint16_t *InputBuffer::gpReadLimit = NULL;
 uint32_t InputBuffer::lastBufferCRC;
 
 bool InputBuffer::IsEmpty()
 {
+    if (gpReadLimit != NULL && gpNextReadPosition == gpReadLimit)
+    {
+        return true;
+    }
     return (gpNextReadPosition == (uint16_t *)dma_channel_hw_addr(DMA_CHANNEL_INPUT_BUFFER)->write_addr);
 }
 
+// Number of values not read yet
+int InputBuffer::GetCount()
+{
+    uint16_t *writePosition = (uint16_t *)dma_channel_hw_addr(DMA_CHANNEL_INPUT_BUFFER)->write_addr;
+    int count = writePosition - gpNextReadPosition;
+    if (count < 0)
+    {
+        count += ADDRESS_END - ADDRESS_START;
+    }
+    return count;
+}
+
+// The next reads stop after count values (IsEmpty() becomes true there)
+void InputBuffer::SetReadLimit(int count)
+{
+    gpReadLimit = gpNextReadPosition + count;
+    if (gpReadLimit >= ADDRESS_END)
+    {
+        gpReadLimit -= ADDRESS_END - ADDRESS_START;
+    }
+}
+
+// Drops what is left before the limit and removes the limit
+void InputBuffer::SkipToReadLimit()
+{
+    if (gpReadLimit != NULL)
+    {
+        gpNextReadPosition = gpReadLimit;
+        gpReadLimit = NULL;
+    }
+}
+
 uint16_t InputBuffer::GetValue()
 {
     uint16_t value;
@@ -37,8 +74,33 @@ bool InputBuffer::GetValue(uint16_t *value)
     }
 }
 
+// Value at gpNextReadPosition + index, without consuming it
+bool InputBuffer::PeekValue(int index, uint16_t *value)
+{
+    uint16_t *p = gpNextReadPosition;
+    uint16_t *writePosition = (uint16_t *)dma_channel_hw_addr(DMA_CHANNEL_INPUT_BUFFER)->write_addr;
+    for (int i = 0; i < index; ++i)
+    {
+        if (p == writePosition)
+        {
+            return false;
+        }
+        if (++p >= ADDRESS_END)
+        {
+            p = ADDRESS_START;
+        }
+    }
+    if (p == writePosition)
+    {
+        return false;
+    }
+    *value = *p;
+    return true;
+}
+
 void InputBuffer::Clear(bool clearEOT)
 {
+    gpReadLimit = NULL;
     // Point to the next address to be read by the DMA channel
     gpNextReadPosition = (uint16_t *)(void *)(dma_channel_hw_addr(DMA_CHANNEL_INPUT_BUFFER)->write_addr);
     
