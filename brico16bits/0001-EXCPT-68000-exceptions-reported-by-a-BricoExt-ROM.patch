 }
 
+// Called after an EOT while an extension runs. A 68000 exception handler
+// ends the output with a 68k command: name (COMMAND68K_NAME_LENGTH letters)
+// then valueCount words. If the buffer ends with onlyName + valueCount words,
+// limits the reads to what comes before it (the extension output) and
+// returns true: display that output, then call RunCutCommand().
+bool CommandManager68k::CutBufferedCommand(const char *onlyName, int valueCount)
+{
+    int start = InputBuffer::GetCount() - COMMAND68K_NAME_LENGTH - valueCount;
+    if (start < 0)
+    {
+        return false;
+    }
+    for (int i = 0; i < COMMAND68K_NAME_LENGTH; ++i)
+    {
+        uint16_t val;
+        if (!InputBuffer::PeekValue(start + i, &val) || val != (uint8_t)onlyName[i])
+        {
+            return false;
+        }
+    }
+    InputBuffer::SetReadLimit(start);
+    return true;
+}
+
+// After CutBufferedCommand(): drops what the display did not read before the
+// command, then reads the command name and runs it.
+void CommandManager68k::RunCutCommand()
+{
+    InputBuffer::SkipToReadLimit();
+    char commandName[COMMAND68K_NAME_LENGTH + 1];
+    for (int i = 0; i < COMMAND68K_NAME_LENGTH; ++i)
+    {
+        commandName[i] = (char)InputBuffer::GetValue();
+    }
+    commandName[COMMAND68K_NAME_LENGTH] = 0;
+    Command68k *cmd = GetCommandByName(commandName);
+    if (cmd != NULL)
+    {
+        cmd->Execute();
+        delete cmd;
+    }
+    InputBuffer::Clear(false);
+}
+
 Command68k * CommandManager68k::GetCommandByName(char * name)
 {
     Command68k *cmd = NULL;
